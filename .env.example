# Dusk — environment variables template
# ------------------------------------------------------
# Copy this file to .env.local and fill with your real values.
# .env.local is in .gitignore — it stays on your machine only.
#
# In Vite, env vars MUST start with VITE_ to be exposed to the browser.

# Supabase — https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
